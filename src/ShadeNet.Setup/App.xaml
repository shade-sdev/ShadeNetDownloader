<Application x:Class="ShadeNet.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="Muted" Color="#5F6368" />

        <Style TargetType="Window" x:Key="SetupWindow">
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="Height" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
        </Style>
    </Application.Resources>
</Application>
