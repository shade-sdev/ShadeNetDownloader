<ui:FluentWindow x:Class="ShadeNetDownloader.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:ShadeNetDownloader.ViewModels"
                 xmlns:views="clr-namespace:ShadeNetDownloader.Views"
                 xmlns:conv="clr-namespace:ShadeNetDownloader.Converters"
                 Title="ShadeNet Downloader"
                 Width="1180" Height="760"
                 MinWidth="900" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                 PreviewKeyDown="OnPreviewKeyDown">

    <ui:FluentWindow.Resources>
        <conv:ThemeIconConverter x:Key="ThemeIcon" />
        <conv:ThemeNameConverter x:Key="ThemeName" />
        <BooleanToVisibilityConverter x:Key="B2V" />

        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- overall progress of the running downloads on the taskbar button -->
    <ui:FluentWindow.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarProgress}" />
    </ui:FluentWindow.TaskbarItemInfo>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddDownloadCommand}" />
    </ui:FluentWindow.InputBindings>

    <!-- the shell: the app, and above it a picture of the old look that fades out when the theme changes -->
    <Grid x:Name="Shell">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Behind everything: a picture and a tint (Settings > Appearance > Background) ===================== -->
        <Grid x:Name="BackgroundLayerHost" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Image Source="{Binding Image}" Stretch="{Binding ImageStretch}" Margin="{Binding BlurMargin}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasImage, Converter={StaticResource B2V}}">
                <Image.Effect>
                    <BlurEffect Radius="{Binding Blur}" RenderingBias="Performance" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <!-- the picture fades into the theme's background, so text on it stays readable -->
            <Rectangle Fill="{DynamicResource ApplicationBackgroundBrush}" Opacity="{Binding Dim}"
                       Visibility="{Binding HasImage, Converter={StaticResource B2V}}" />
            <Rectangle Fill="{Binding Tint}" Opacity="{Binding TintOpacity}"
                       Visibility="{Binding HasTint, Converter={StaticResource B2V}}" />
        </Grid>

        <!-- ===================== Title bar: brand · search · live speed · theme ===================== -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="52" Title="" ShowMaximize="True">
            <!-- the brand sits over the sidebar and the search starts where the content does: the brand column is as wide as the
                 sidebar, less where the title bar puts its left slot (measured in code, see AlignTitleBar) -->
            <ui:TitleBar.Header>
                <Grid x:Name="TitleBarHeader" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BrandColumn" Width="234" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- the title bar treats its slots as part of the window, so the brand area moves the window itself -->
                    <StackPanel x:Name="Brand" Orientation="Horizontal" Background="Transparent" MouseLeftButtonDown="OnBrandMouseDown"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource B2V}}">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="26" Height="26" Margin="14,0,0,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="ShadeNet" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <ui:TextBox x:Name="SearchBox" Grid.Column="1" Width="380" Height="34" VerticalAlignment="Center"
                                AutomationProperties.Name="Search downloads"
                                PlaceholderText="Search downloads"
                                ClearButtonEnabled="True"
                                Icon="{ui:SymbolIcon Search24}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0" ToolTip="Current total download speed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{Binding SpeedText}" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold"
                                       MinWidth="62" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="ThemeButton" Appearance="Transparent" Width="36" Height="34" Padding="0"
                               AutomationProperties.Name="Toggle theme"
                               Click="OnThemeClick"
                               ToolTip="{Binding SettingsPage.SelectedTheme, Converter={StaticResource ThemeName}}">
                        <ui:SymbolIcon FontSize="18"
                                       Symbol="{Binding SettingsPage.SelectedTheme, Converter={StaticResource ThemeIcon}}" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <!-- its width glides between names and icons only (MainWindow.AnimateSidebar); what is wider is cut off meanwhile -->
            <Grid x:Name="Sidebar" Grid.Column="0" Margin="0,0,0,10" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- icons with names, or icons only (its centre lines up with the items' icons in both) -->
                <ui:Button Grid.Row="0" Appearance="Transparent" Width="40" Height="34" Padding="0" Margin="14,0,0,4"
                           HorizontalAlignment="Left" Icon="{ui:SymbolIcon Navigation24}"
                           Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleTip}"
                           AutomationProperties.Name="{Binding SidebarToggleTip}" />

                <ui:Button Grid.Row="1" Appearance="Primary" Height="42" Margin="14,2,14,12"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Icon="{ui:SymbolIcon Add24}" Content="Add download"
                           Command="{Binding AddDownloadCommand}"
                           ToolTip="Add a download  (Ctrl+N)"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource B2V}}" />
                <ui:Button Grid.Row="1" Appearance="Primary" Width="42" Height="42" Padding="0" Margin="0,2,0,12"
                           HorizontalAlignment="Center" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding AddDownloadCommand}"
                           ToolTip="Add a download  (Ctrl+N)" AutomationProperties.Name="Add download"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseB2V}}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Primary}" ItemTemplate="{StaticResource NavItemTemplate}"
                                      IsTabStop="False" />
                        <TextBlock Style="{StaticResource NavSectionHeader}" Text="CATEGORIES"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource B2V}}" />
                        <Rectangle Height="1" Margin="18,14,18,10" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseB2V}}" />
                        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource NavItemTemplate}"
                                      IsTabStop="False" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <Rectangle Height="1" Margin="18,4,18,6" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ContentControl Content="{Binding SettingsItem}" ContentTemplate="{StaticResource NavItemTemplate}"
                                    IsTabStop="False" />
                </StackPanel>
            </Grid>

            <!-- Content sheet -->
            <Border Grid.Column="1" Style="{StaticResource Sheet}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="PageHost" Grid.Row="0" Content="{Binding CurrentPage}" IsTabStop="False" />

                    <!-- status bar -->
                    <Border Grid.Row="1" Height="36" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding DiskText}" FontSize="12" Margin="0,0,24,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <!-- what happens when the downloads are done -->
                            <ui:Button x:Name="FinishButton" Grid.Column="2" Appearance="Transparent" Padding="8,3"
                                       Margin="0,0,4,0" VerticalAlignment="Center" Height="28"
                                       ToolTip="What to do when all downloads are finished" AutomationProperties.Name="When finished"
                                       Click="OnFinishButtonClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Power24" FontSize="14" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FinishArmed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Text="{Binding FinishText}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:Button>

                            <!-- total speed limit: a button that opens the flyout -->
                            <ui:Button x:Name="LimitButton" Grid.Column="3" Appearance="Transparent" Padding="8,3"
                                       Margin="0,0,-8,0" VerticalAlignment="Center" Height="28"
                                       ToolTip="Limit the total download speed" AutomationProperties.Name="Speed limit"
                                       Click="OnLimitButtonClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Gauge24" FontSize="14" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Limit.IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Text="{Binding LimitText}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:Button>

                            <Popup x:Name="LimitPopup" PlacementTarget="{Binding ElementName=LimitButton}"
                                   Placement="Custom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   Closed="OnLimitPopupClosed"
                                   IsOpen="{Binding Limit.IsOpen, Mode=TwoWay}">
                                <Border Margin="14" Padding="18,16" CornerRadius="12" Width="340"
                                        Background="{DynamicResource ApplicationBackgroundBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Direction="270" />
                                    </Border.Effect>
                                    <StackPanel DataContext="{Binding Limit}">
                                        <TextBlock Text="Speed limit" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Button Content="{Binding Label}" Margin="0,0,6,6" Padding="11,5" MinWidth="64"
                                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Or type a speed" FontSize="12" Margin="0,8,0,6"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="e.g. 3.5" AutomationProperties.Name="Custom speed limit">
                                                <ui:TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding ApplyCustomCommand}" />
                                                </ui:TextBox.InputBindings>
                                            </ui:TextBox>
                                            <Border Grid.Column="1" CornerRadius="9" Padding="3" Margin="8,0"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton GroupName="limitUnit" Style="{StaticResource SegmentRadio}" MinWidth="48" Padding="6,0"
                                                                 Height="28" Content="KB/s" IsChecked="{Binding CustomInKilobytes, Mode=TwoWay}" />
                                                    <RadioButton GroupName="limitUnit" Style="{StaticResource SegmentRadio}" MinWidth="48" Padding="6,0"
                                                                 Height="28" Content="MB/s" IsChecked="{Binding CustomInMegabytes, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Border>
                                            <ui:Button Grid.Column="2" Content="Set" Appearance="Primary" Height="34"
                                                       Command="{Binding ApplyCustomCommand}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Error}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock Text="A download can also have its own limit: open its details." FontSize="11"
                                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- drop target hint, shown while something is dragged over the window -->
        <Border x:Name="DropOverlay" Grid.Row="1" Margin="{Binding DropMargin}" CornerRadius="14"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
            <Grid>
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="5 4"
                           Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Drop links to download" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,2" />
                    <TextBlock Text="Text, links or a .txt / .url file" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- toast: one at a time, bottom centre -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,58"
                DataContext="{Binding Toasts}" MinWidth="300" MaxWidth="560" Padding="16,10,8,10" CornerRadius="10"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                RenderTransformOrigin="0.5,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="14" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <!-- defaults live in the style (a local value would beat the trigger below) -->
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Current, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{StaticResource MotionBase}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0"
                                                         Duration="{StaticResource MotionBase}"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource MotionFast}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="14"
                                                         Duration="{StaticResource MotionFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="{Binding Current.Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Kind}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Current.Kind}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding Current.Message}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                <ui:Button Appearance="Transparent" Margin="12,0,0,0" Height="32" Padding="12,0"
                           Content="{Binding Current.ActionText}" Command="{Binding RunActionCommand}"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"
                           Visibility="{Binding Current.ActionText, Converter={StaticResource NullToCollapsed}}" />
                <ui:Button Appearance="Transparent" Width="32" Height="32" Padding="0" Margin="2,0,0,0"
                           AutomationProperties.Name="Dismiss" Command="{Binding DismissCommand}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- host for modal dialogs (Add download) -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
    </Grid>

        <Image x:Name="ThemeSnapshot" IsHitTestVisible="False" Visibility="Collapsed" Stretch="Fill" />
    </Grid>
</ui:FluentWindow>
