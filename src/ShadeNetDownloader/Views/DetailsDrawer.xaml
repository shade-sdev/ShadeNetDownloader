<UserControl x:Class="ShadeNetDownloader.Views.DetailsDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:ShadeNetDownloader.Controls"
             xmlns:vm="clr-namespace:ShadeNetDownloader.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- one working connection -->
        <DataTemplate DataType="{x:Type vm:ConnectionRowViewModel}">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding SpeedText}" FontWeight="SemiBold" />
                    </Grid>
                    <ctl:ProgressTrack Height="4" Margin="0,8,0,6" Value="{Binding Fraction}"
                                       Track="{DynamicResource SubtleFillColorTertiaryBrush}" Fill="{Binding Brush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding DoneText}" Style="{StaticResource Caption}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- one fact about the download -->
        <DataTemplate DataType="{x:Type vm:PropertyRow}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="13"
                               ToolTip="{Binding Value}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Transparent" Width="30" Height="30" Padding="0" VerticalAlignment="Top"
                           ToolTip="Copy" AutomationProperties.Name="Copy"
                           Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}"
                           Visibility="{Binding CanCopy, Converter={StaticResource B2V}}">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                </ui:Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Grid Grid.Row="0" Margin="20,18,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Image Source="{Binding Item.Icon}" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.FileName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.FileName}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding Item.StatusText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Item.Host, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <ui:Button x:Name="CloseButton" Grid.Column="2" Appearance="Transparent" Width="34" Height="34" Padding="0"
                           VerticalAlignment="Top" ToolTip="Close (Esc)" AutomationProperties.Name="Close details"
                           Click="OnClose">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                </ui:Button>
            </Grid>

            <!-- ============ tabs ============ -->
            <Border Grid.Row="1" Margin="20,16,20,12" CornerRadius="9" Padding="3" HorizontalAlignment="Stretch"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <UniformGrid Rows="1">
                    <RadioButton GroupName="detailsTab" Style="{StaticResource SegmentRadio}" Padding="6,6" Content="Overview"
                                 IsChecked="{Binding IsOverview, Mode=TwoWay}" />
                    <RadioButton GroupName="detailsTab" Style="{StaticResource SegmentRadio}" Padding="6,6" Content="Connections"
                                 IsChecked="{Binding IsConnections, Mode=TwoWay}" />
                    <RadioButton GroupName="detailsTab" Style="{StaticResource SegmentRadio}" Padding="6,6" Content="Properties"
                                 IsChecked="{Binding IsProperties, Mode=TwoWay}" />
                </UniformGrid>
            </Border>

            <!-- ============ overview ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsOverview, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">

                    <!-- the numbers -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Headline}" FontSize="26" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SubHeadline}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SubHeadline}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding EtaText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="time left" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="20,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Item.Fraction, StringFormat={}{0:P0}}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="done" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <ctl:ProgressTrack Height="6" Value="{Binding Item.Fraction}"
                                       IsIndeterminate="{Binding Item.IsIndeterminate}"
                                       Track="{DynamicResource SubtleFillColorTertiaryBrush}"
                                       Fill="{StaticResource ProgressFillActive}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,8,0,16" />

                    <!-- speed -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}">
                                    <Run Text="peak " /><Run Text="{Binding PeakText, Mode=OneWay}" /><Run Text="  ·  average " /><Run Text="{Binding AverageText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,8,0,0" Height="120">
                                <ctl:SpeedGraph Samples="{Binding Item.SpeedSamples}"
                                                Line="{DynamicResource AccentFillColorDefaultBrush}"
                                                Grid="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                                Label="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="The graph fills in once the download is running." Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Visibility="{Binding HasSamples, Converter={StaticResource InverseB2V}}" />
                            </Grid>
                            <TextBlock Text="Last two minutes" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- blocks -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="File map" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding BlocksText}" Style="{StaticResource Caption}" />
                            </Grid>
                            <ctl:SegmentMap Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                            Segments="{Binding Item.Segments}"
                                            Total="{Binding Item.TotalBytes, TargetNullValue=0, FallbackValue=0}"
                                            DoneBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                            EmptyBrush="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                            Visibility="{Binding HasBlocks, Converter={StaticResource B2V}}" />
                            <TextBlock Text="{Binding BlocksCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasBlocks, Converter={StaticResource B2V}}" />
                            <TextBlock Text="The map appears once the size of the file is known." Style="{StaticResource Caption}"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasBlocks, Converter={StaticResource InverseB2V}}" />
                        </StackPanel>
                    </Border>

                    <!-- what the engine did -->
                    <Border Style="{StaticResource Panel}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Connections and engine" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,0,12" ToolTip="Connections working right now.">
                                    <TextBlock Text="{Binding Item.ConnectionCount}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="working now" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" ToolTip="The most connections this download has used at once.">
                                    <TextBlock Text="{Binding Item.PeakConnections}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="peak" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" ToolTip="A running part was cut in two so another connection could help.">
                                    <TextBlock Text="{Binding Item.Splits}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="splits" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="A connection that finished carried on into its neighbour's part without reconnecting.">
                                    <TextBlock Text="{Binding Item.Takeovers}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="takeovers" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Times a connection was started again after a hiccup.">
                                    <TextBlock Text="{Binding Item.Retries}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="retries" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Times the server forced a restart with a single connection.">
                                    <TextBlock Text="{Binding Item.Fallbacks}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="fallbacks" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ connections ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsConnections, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">
                    <TextBlock Text="{Binding ConnectionsSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Connections}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ properties ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsProperties, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">
                    <ItemsControl ItemsSource="{Binding Properties}" Focusable="False" />

                    <Border Style="{StaticResource Panel}" Margin="0,8,0,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="Limits for this download" FontWeight="SemiBold" />

                            <TextBlock Text="Speed limit" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="No limit" AutomationProperties.Name="Speed limit in KB per second" />
                                <TextBlock Grid.Column="1" Text="KB/s" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="2" Content="Apply" Command="{Binding ApplyLimitCommand}" Height="34" />
                            </Grid>
                            <TextBlock Text="{Binding LimitStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding LimitStatus, Converter={StaticResource NullToCollapsed}}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connections at most" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionLimit}" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                            <Slider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                    Value="{Binding ConnectionLimit, Mode=TwoWay}"
                                    AutomationProperties.Name="Connections at most" />
                            <TextBlock Text="{Binding ConnectionLimitHint}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
