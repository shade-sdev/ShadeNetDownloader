<UserControl x:Class="ShadeNetDownloader.Views.DetailsDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:ShadeNetDownloader.Controls"
             xmlns:vm="clr-namespace:ShadeNetDownloader.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- the drawer's tabs: five for a torrent (Overview, Peers, Files, Trackers, Properties) fit when they are a little smaller -->
        <Style x:Key="DrawerTab" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
            <Setter Property="Padding" Value="6,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTorrent}" Value="True">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="2,6" />
                    <Setter Property="FontSize" Value="12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- one working connection -->
        <DataTemplate DataType="{x:Type vm:ConnectionRowViewModel}">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding SpeedText}" FontWeight="SemiBold" />
                    </Grid>
                    <ctl:ProgressTrack Height="4" Margin="0,8,0,6" Value="{Binding Fraction}"
                                       Track="{DynamicResource SubtleFillColorTertiaryBrush}" Fill="{Binding Brush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding DoneText}" Style="{StaticResource Caption}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- one peer of a torrent -->
        <DataTemplate DataType="{x:Type vm:TorrentPeerRow}">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Address}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Client}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Client}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SpeedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="6,-4,-6,0"
                                       ToolTip="Ban this address: it is disconnected from every torrent and not connected to again"
                                       AutomationProperties.Name="{Binding Address, StringFormat='Ban {0}'}"
                                       Command="{Binding DataContext.BanPeerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}">
                                <ui:SymbolIcon Symbol="Prohibited24" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <ctl:ProgressTrack Height="4" Margin="0,8,0,6" Value="{Binding Progress}"
                                       Track="{DynamicResource SubtleFillColorTertiaryBrush}" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FlagsText}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- one file of a torrent -->
        <DataTemplate DataType="{x:Type vm:TorrentFileRow}">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        <ctl:ProgressTrack Height="4" Margin="0,8,0,6" Value="{Binding Progress}"
                                           Track="{DynamicResource SubtleFillColorTertiaryBrush}" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ProgressText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="104" VerticalAlignment="Center"
                              ItemsSource="{x:Static vm:TorrentFileRow.Choices}" SelectedItem="{Binding Priority, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Path}" ToolTip="High: fetched first. Skip: not downloaded." />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- one tracker of a torrent (or the DHT) -->
        <DataTemplate DataType="{x:Type vm:TorrentTrackerRow}">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Address}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{Binding TierText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="4,-6,-6,0"
                                       ToolTip="Take this tracker off (it stays off when the torrent starts again)"
                                       AutomationProperties.Name="{Binding Address, StringFormat='Remove {0}'}"
                                       Command="{Binding DataContext.RemoveTrackerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding CanRemove, Converter={StaticResource B2V}}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CountsText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="{Binding CountsText, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- one fact about the download -->
        <DataTemplate DataType="{x:Type vm:PropertyRow}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="13"
                               ToolTip="{Binding Value}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Transparent" Width="30" Height="30" Padding="0" VerticalAlignment="Top"
                           ToolTip="Copy" AutomationProperties.Name="Copy"
                           Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}"
                           Visibility="{Binding CanCopy, Converter={StaticResource B2V}}">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                </ui:Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Grid Grid.Row="0" Margin="20,18,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Image Source="{Binding Item.Icon}" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.FileName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.FileName}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding Item.StatusText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Item.Host, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <ui:Button x:Name="CloseButton" Grid.Column="2" Appearance="Transparent" Width="34" Height="34" Padding="0"
                           VerticalAlignment="Top" ToolTip="Close (Esc)" AutomationProperties.Name="Close details"
                           Click="OnClose">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                </ui:Button>
            </Grid>

            <!-- ============ tabs ============ -->
            <Border Grid.Row="1" Margin="20,16,20,12" CornerRadius="9" Padding="3" HorizontalAlignment="Stretch"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <UniformGrid Rows="1">
                    <RadioButton GroupName="detailsTab" Style="{StaticResource DrawerTab}" Content="Overview"
                                 IsChecked="{Binding IsOverview, Mode=TwoWay}" />
                    <RadioButton GroupName="detailsTab" Style="{StaticResource DrawerTab}" Content="{Binding ConnectionsTabTitle}"
                                 IsChecked="{Binding IsConnections, Mode=TwoWay}" />
                    <RadioButton GroupName="detailsTab" Style="{StaticResource DrawerTab}" Content="Files"
                                 IsChecked="{Binding IsFiles, Mode=TwoWay}" Visibility="{Binding IsTorrent, Converter={StaticResource B2V}}" />
                    <RadioButton GroupName="detailsTab" Style="{StaticResource DrawerTab}" Content="Trackers"
                                 IsChecked="{Binding IsTrackers, Mode=TwoWay}" Visibility="{Binding IsTorrent, Converter={StaticResource B2V}}" />
                    <RadioButton GroupName="detailsTab" Style="{StaticResource DrawerTab}" Content="Properties"
                                 IsChecked="{Binding IsProperties, Mode=TwoWay}" />
                </UniformGrid>
            </Border>

            <!-- ============ overview ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsOverview, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">

                    <!-- the numbers -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Headline}" FontSize="26" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SubHeadline}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SubHeadline}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding EtaText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="time left" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="20,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Item.Fraction, StringFormat={}{0:P0}}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="done" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <ctl:ProgressTrack Height="6" Value="{Binding Item.Fraction}"
                                       IsIndeterminate="{Binding Item.IsIndeterminate}"
                                       Track="{DynamicResource SubtleFillColorTertiaryBrush}"
                                       Fill="{StaticResource ProgressFillActive}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,8,0,16" />

                    <!-- speed -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}">
                                    <Run Text="peak " /><Run Text="{Binding PeakText, Mode=OneWay}" /><Run Text="  ·  average " /><Run Text="{Binding AverageText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,8,0,0" Height="120">
                                <ctl:SpeedGraph Samples="{Binding Item.SpeedSamples}"
                                                Line="{DynamicResource AccentFillColorDefaultBrush}"
                                                Grid="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                                Label="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="The graph fills in once the download is running." Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Visibility="{Binding HasSamples, Converter={StaticResource InverseB2V}}" />
                            </Grid>
                            <TextBlock Text="Last two minutes" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- blocks -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MapTitle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding BlocksText}" Style="{StaticResource Caption}" />
                            </Grid>
                            <ctl:SegmentMap Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                            Segments="{Binding MapSegments}"
                                            Total="{Binding MapTotal}"
                                            DoneBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                            EmptyBrush="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                            Visibility="{Binding HasBlocks, Converter={StaticResource B2V}}" />
                            <TextBlock Text="{Binding BlocksCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasBlocks, Converter={StaticResource B2V}}" />
                            <TextBlock Text="The map appears once the size of the file is known." Style="{StaticResource Caption}"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasBlocks, Converter={StaticResource InverseB2V}}" />
                        </StackPanel>
                    </Border>

                    <!-- a torrent: peers, sharing, pieces -->
                    <Border Style="{StaticResource Panel}" Margin="0" Visibility="{Binding IsTorrent, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="Peers and sharing" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,0,12" ToolTip="People the torrent is connected to right now.">
                                    <TextBlock Text="{Binding Item.ConnectionCount}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="peers now" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" ToolTip="Connected peers that have the whole torrent.">
                                    <TextBlock Text="{Binding SeedsText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="have all of it" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" ToolTip="The most peers at once.">
                                    <TextBlock Text="{Binding Item.PeakConnections}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="peak" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Sent to others, over all runs.">
                                    <TextBlock Text="{Binding SharedText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="shared" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Shared ÷ the size of the chosen files.">
                                    <TextBlock Text="{Binding RatioText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="ratio" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Pieces on the disk, of the whole torrent.">
                                    <TextBlock Text="{Binding PiecesText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="pieces" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding SwarmText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding SwarmText, Converter={StaticResource NullToCollapsed}}" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Content="Ask for peers now" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"
                                           Command="{Binding AskForPeersCommand}"
                                           ToolTip="Asks every tracker, the DHT and the local network for peers at once (rather than at their next turn)."
                                           Visibility="{Binding TorrentRunning, Converter={StaticResource B2V}}" />
                                <ui:Button Content="Check the files again" Icon="{ui:SymbolIcon DocumentSearch24}"
                                           Command="{Binding CheckFilesAgainCommand}"
                                           ToolTip="Checks every piece on the disk against the torrent; whatever is missing or damaged is downloaded again." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- what the engine did -->
                    <Border Style="{StaticResource Panel}" Margin="0" Visibility="{Binding IsTorrent, Converter={StaticResource InverseB2V}}">
                        <StackPanel>
                            <TextBlock Text="Connections and engine" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,0,12" ToolTip="Connections working right now.">
                                    <TextBlock Text="{Binding Item.ConnectionCount}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="working now" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" ToolTip="The most connections this download has used at once.">
                                    <TextBlock Text="{Binding Item.PeakConnections}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="peak" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" ToolTip="A running part was cut in two so another connection could help.">
                                    <TextBlock Text="{Binding Item.Splits}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="splits" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="A connection that finished carried on into its neighbour's part without reconnecting.">
                                    <TextBlock Text="{Binding Item.Takeovers}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="takeovers" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Times a connection was started again after a hiccup.">
                                    <TextBlock Text="{Binding Item.Retries}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="retries" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel ToolTip="Times the server forced a restart with a single connection.">
                                    <TextBlock Text="{Binding Item.Fallbacks}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="fallbacks" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ connections ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsConnections, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">
                    <TextBlock Text="{Binding ConnectionsSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Connections}" Focusable="False"
                                  Visibility="{Binding IsTorrent, Converter={StaticResource InverseB2V}}" />
                    <!-- a torrent: someone known to share it, by hand -->
                    <Border Style="{StaticResource Panel}" Visibility="{Binding IsTorrent, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="Add a peer" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                                       Text="Someone you know shares this torrent: their address and port, e.g. 203.0.113.7:51413 or [2001:db8::7]:51413. Only while it runs." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding NewPeer, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="address:port"
                                            AutomationProperties.Name="Peer address" IsEnabled="{Binding TorrentRunning}" />
                                <ui:Button Grid.Column="1" Content="Add" Margin="8,0,0,0" Height="34" Command="{Binding AddPeerCommand}"
                                           IsEnabled="{Binding TorrentRunning}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Peers}" Focusable="False" AutomationProperties.Name="Peers"
                                  Visibility="{Binding IsTorrent, Converter={StaticResource B2V}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ files (a torrent) ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsFiles, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Download in order" FontWeight="SemiBold" />
                                <TextBlock Text="Fetches the pieces from the start of the files, so a film can be watched while the rest arrives. Torrents come in faster the usual way."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Sequential, Mode=TwoWay}" VerticalAlignment="Center"
                                             AutomationProperties.Name="Download in order" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding FilesSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding TorrentFiles}" Focusable="False" AutomationProperties.Name="Files of the torrent" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ trackers (a torrent) ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsTrackers, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">
                    <TextBlock Text="{Binding TrackersSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SwarmText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding SwarmText, Converter={StaticResource NullToCollapsed}}" />
                    <ui:Button Content="Ask for peers now" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,12" Command="{Binding AskForPeersCommand}"
                               Visibility="{Binding TorrentRunning, Converter={StaticResource B2V}}" />
                    <ItemsControl ItemsSource="{Binding Trackers}" Focusable="False" AutomationProperties.Name="Trackers" />
                    <Border Style="{StaticResource Panel}" Margin="0,4,0,0" Visibility="{Binding IsPrivateTorrent, Converter={StaticResource InverseB2V}}">
                        <StackPanel>
                            <TextBlock Text="Add trackers" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                                       Text="One address per line (udp://, http:// or https://). Each is asked on its own, at once, and kept when the torrent starts again." />
                            <ui:TextBox Text="{Binding NewTrackers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                        MinHeight="64" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="udp://tracker.example.org:1337/announce" AutomationProperties.Name="Tracker addresses" />
                            <ui:Button Content="Add" HorizontalAlignment="Right" Margin="0,8,0,0" Command="{Binding AddTrackersCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ properties ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsProperties, Converter={StaticResource B2V}}">
                <StackPanel Margin="20,0,20,20">
                    <ItemsControl ItemsSource="{Binding Properties}" Focusable="False" />

                    <Border Style="{StaticResource Panel}" Margin="0,8,0,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="Limits for this download" FontWeight="SemiBold" />

                            <TextBlock Text="Speed limit" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="No limit" AutomationProperties.Name="Speed limit in KB per second" />
                                <TextBlock Grid.Column="1" Text="KB/s" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="2" Content="Apply" Command="{Binding ApplyLimitCommand}" Height="34" />
                            </Grid>
                            <TextBlock Text="{Binding LimitStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding LimitStatus, Converter={StaticResource NullToCollapsed}}" />

                            <StackPanel Visibility="{Binding IsTorrent, Converter={StaticResource InverseB2V}}">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connections at most" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionLimit}" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                            <Slider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                    Value="{Binding ConnectionLimit, Mode=TwoWay}"
                                    AutomationProperties.Name="Connections at most" />
                            <TextBlock Text="{Binding ConnectionLimitHint}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
