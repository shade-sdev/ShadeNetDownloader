<UserControl x:Class="ShadeNetDownloader.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ShadeNetDownloader.ViewModels"
             xmlns:ctl="clr-namespace:ShadeNetDownloader.Controls"
             xmlns:views="clr-namespace:ShadeNetDownloader.Views"
             xmlns:svc="clr-namespace:ShadeNetDownloader.Services"
             Loaded="OnLoaded" SizeChanged="OnSizeChanged" PreviewKeyDown="OnPreviewKeyDown"
             DataContextChanged="OnDataContextChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!-- right-click menu; DataContext is the card under the mouse. Not shared: every card gets its own instance. -->
        <ContextMenu x:Key="CardMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenFileCommand}"
                      Visibility="{Binding IsCompleted, Converter={StaticResource B2V}}" />
            <MenuItem Header="Open with…" Icon="{ui:SymbolIcon AppsListDetail24}" Command="{Binding OpenWithCommand}"
                      Visibility="{Binding IsCompleted, Converter={StaticResource B2V}}" />
            <MenuItem Header="Details" Icon="{ui:SymbolIcon Info24}" Command="{Binding ShowDetailsCommand}"
                      InputGestureText="Alt+Enter" />
            <MenuItem Header="Stop and save" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopAndSaveCommand}"
                      Visibility="{Binding IsRecording, Converter={StaticResource B2V}}" />
            <MenuItem Header="Pause" Icon="{ui:SymbolIcon Pause24}" Command="{Binding PauseCommand}"
                      Visibility="{Binding CanPause, Converter={StaticResource B2V}}" />
            <MenuItem Header="Resume" Icon="{ui:SymbolIcon Play24}" Command="{Binding ResumeCommand}"
                      Visibility="{Binding CanResume, Converter={StaticResource B2V}}" />
            <MenuItem Header="Add to queue" Icon="{ui:SymbolIcon ArrowEnterUp24}" Command="{Binding AddToQueueCommand}"
                      Visibility="{Binding CanQueue, Converter={StaticResource B2V}}" />
            <MenuItem Header="Move to top" Icon="{ui:SymbolIcon ArrowUpload24}" Command="{Binding MoveToTopCommand}"
                      Visibility="{Binding CanMoveInQueue, Converter={StaticResource B2V}}" />
            <MenuItem Header="Move up" Icon="{ui:SymbolIcon ChevronUp24}" Command="{Binding MoveUpCommand}"
                      Visibility="{Binding CanMoveInQueue, Converter={StaticResource B2V}}" />
            <MenuItem Header="Move down" Icon="{ui:SymbolIcon ChevronDown24}" Command="{Binding MoveDownCommand}"
                      Visibility="{Binding CanMoveInQueue, Converter={StaticResource B2V}}" />
            <MenuItem Header="Move to bottom" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding MoveToBottomCommand}"
                      Visibility="{Binding CanMoveInQueue, Converter={StaticResource B2V}}" />
            <MenuItem Header="Refresh address" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshAddressCommand}"
                      Visibility="{Binding CanRefreshAddress, Converter={StaticResource B2V}}" />
            <MenuItem Header="Open the page it came from" Icon="{ui:SymbolIcon Globe24}" Command="{Binding OpenOwnerPageCommand}"
                      Visibility="{Binding HasOwnerPage, Converter={StaticResource B2V}}" />
            <MenuItem Header="Show in folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ShowInFolderCommand}" />
            <MenuItem Header="Copy link" Icon="{ui:SymbolIcon Link24}" Command="{Binding CopyLinkCommand}" />
            <Separator />
            <MenuItem Header="Remove from list" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RemoveFromListCommand}" />
            <MenuItem Header="Remove and delete file" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveAndDeleteCommand}" />
        </ContextMenu>

        <!-- The menu hangs on the ROW (not on the card inside it): right-click anywhere on the row works, and so do the
             keyboard routes (Shift+F10 / the Menu key), which fire on the focused row. -->
        <Style x:Key="DownloadRow" TargetType="ListViewItem" BasedOn="{StaticResource DownloadRowContainer}">
            <Setter Property="ContextMenu" Value="{StaticResource CardMenu}" />
        </Style>

        <!-- one download card -->
        <DataTemplate x:Key="DownloadCard" DataType="{x:Type vm:DownloadItemViewModel}">
            <Border x:Name="Card" Margin="{DynamicResource DownloadCardGap}" Padding="{DynamicResource DownloadCardPadding}" CornerRadius="{DynamicResource CardRadius}" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    SnapsToDevicePixels="True">
                <!-- a new download slides in from above (IsNew, below) -->
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- file-type icon -->
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11" VerticalAlignment="Top"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Image Source="{Binding Icon}" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- name, progress, details -->
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"
                                       VerticalAlignment="Center" />

                            <!-- status chip -->
                            <Border x:Name="Chip" Grid.Column="1" Margin="12,0,0,0" Padding="9,2" CornerRadius="{DynamicResource RadiusBadge}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                <!-- the label pops when the download finishes (JustCompleted, below) -->
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <TextBlock x:Name="ChipText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <ctl:ProgressTrack x:Name="Bar" Height="6" Margin="0,10,0,0"
                                           Value="{Binding Fraction}" IsIndeterminate="{Binding IsIndeterminate}"
                                           Track="{DynamicResource SubtleFillColorTertiaryBrush}"
                                           Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DetailText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DetailText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding HintText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HintText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- actions: primary is always there, the rest appears on hover / selection -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="Extras" Orientation="Horizontal" Opacity="0">
                            <ui:Button Appearance="Transparent" Width="34" Height="34" Padding="0"
                                       ToolTip="Details (Alt+Enter)" AutomationProperties.Name="Details"
                                       Command="{Binding ShowDetailsCommand}">
                                <ui:SymbolIcon Symbol="Info24" FontSize="18" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Width="34" Height="34" Padding="0"
                                       ToolTip="Show in folder" AutomationProperties.Name="Show in folder"
                                       Command="{Binding ShowInFolderCommand}">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Width="34" Height="34" Padding="0"
                                       ToolTip="Remove from list" AutomationProperties.Name="Remove from list"
                                       Command="{Binding RemoveFromListCommand}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                            </ui:Button>
                        </StackPanel>

                        <ui:Button Appearance="Secondary" Width="38" Height="38" Padding="0" Margin="4,0,0,0"
                                   ToolTip="{Binding PrimaryTooltip}" AutomationProperties.Name="{Binding PrimaryTooltip}"
                                   Command="{Binding PrimaryActionCommand}"
                                   Visibility="{Binding HasPrimaryAction, Converter={StaticResource B2V}}">
                            <ui:SymbolIcon Symbol="{Binding PrimaryIcon}" FontSize="18" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- hover / selection reveal the secondary actions -->
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Extras" Property="Opacity" Value="1" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter TargetName="Extras" Property="Opacity" Value="1" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <!-- the download whose details are open in the drawer -->
                <DataTrigger Binding="{Binding IsDetailsTarget}" Value="True">
                    <Setter TargetName="Extras" Property="Opacity" Value="1" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </DataTrigger>

                <!-- motion: a new card slides in, a finished one's label pops (the flags are set only while motion is on) -->
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="{StaticResource MotionSlow}" EasingFunction="{StaticResource EaseOut}" FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-16" To="0"
                                                 Duration="{StaticResource MotionSlow}" EasingFunction="{StaticResource EaseOut}" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding JustCompleted}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chip" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" FillBehavior="Stop">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.2" EasingFunction="{StaticResource EaseOut}" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1" EasingFunction="{StaticResource EaseOut}" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chip" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" FillBehavior="Stop">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.2" EasingFunction="{StaticResource EaseOut}" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1" EasingFunction="{StaticResource EaseOut}" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <!-- state colours -->
                <DataTrigger Binding="{Binding State}" Value="Downloading">
                    <Setter TargetName="Bar" Property="Fill" Value="{StaticResource ProgressFillActive}" />
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Probing">
                    <Setter TargetName="Bar" Property="Fill" Value="{StaticResource ProgressFillActive}" />
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Completed">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Paused">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                     Duration="{StaticResource MotionBase}"
                                     EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- page header -->
        <Grid Grid.Row="0" Margin="32,24,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- a grid, not a stack: the subtitle may be cut with an ellipsis when the drawer narrows the page -->
            <Grid x:Name="Heading" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Margin="14,0,0,5" FontSize="14" VerticalAlignment="Bottom"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- the Queued page: the queue's own start/stop (stopping lets running downloads finish; nothing new starts) -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsQueueView, Converter={StaticResource B2V}}">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Content="Start queue"
                               Margin="0,0,8,0" Height="34"
                               Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               Visibility="{Binding DataContext.QueueRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseB2V}}" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Stop24}" Content="Stop queue"
                               Margin="0,0,8,0" Height="34"
                               Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               Visibility="{Binding DataContext.QueueRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}" />
                </StackPanel>
                <!-- the order of the list (the Queued list shows the order the queue runs in) -->
                <ui:Button x:Name="SortButton" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSort24}" Margin="0,0,8,0" Height="34"
                           Click="OnSortClick" ToolTip="Sort the list" AutomationProperties.Name="Sort the list"
                           Visibility="{Binding IsQueueView, Converter={StaticResource InverseB2V}}">
                    <TextBlock>
                        <Run Text="Sort:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding SortLabel, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Name" IsChecked="{Binding IsSortByName, Mode=OneWay}"
                                      Command="{Binding SortByKeyCommand}" CommandParameter="{x:Static svc:DownloadSortKey.Name}" />
                            <MenuItem Header="File type" IsChecked="{Binding IsSortByType, Mode=OneWay}"
                                      Command="{Binding SortByKeyCommand}" CommandParameter="{x:Static svc:DownloadSortKey.FileType}" />
                            <MenuItem Header="Size" IsChecked="{Binding IsSortBySize, Mode=OneWay}"
                                      Command="{Binding SortByKeyCommand}" CommandParameter="{x:Static svc:DownloadSortKey.Size}" />
                            <MenuItem Header="Date added" IsChecked="{Binding IsSortByDate, Mode=OneWay}"
                                      Command="{Binding SortByKeyCommand}" CommandParameter="{x:Static svc:DownloadSortKey.Date}" />
                            <Separator />
                            <MenuItem Header="{Binding AscendingLabel}" Command="{Binding SetAscendingCommand}"
                                      IsChecked="{Binding SortAscending, Mode=OneWay}" />
                            <MenuItem Header="{Binding DescendingLabel}" Command="{Binding SetDescendingCommand}"
                                      IsChecked="{Binding SortDescending, Mode=OneWay}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DeleteDismiss24}" Content="Clear list"
                           Margin="0,0,8,0" Height="34" Command="{Binding ClearCompletedCommand}"
                           Visibility="{Binding ShowClearCompleted, Converter={StaticResource B2V}}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" Content="Resume all"
                           Margin="0,0,8,0" Height="34"
                           Command="{Binding DataContext.ResumeAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Pause24}" Content="Pause all" Height="34"
                           Command="{Binding DataContext.PauseAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <!-- the list: virtualised and pixel-scrolled, so hundreds of cards stay smooth -->
        <ListView x:Name="List" Grid.Row="1" ItemsSource="{Binding View}"
                  ItemTemplate="{StaticResource DownloadCard}"
                  ItemContainerStyle="{StaticResource DownloadRow}"
                  SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="0,2,0,12"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown"
                  MouseDoubleClick="OnListDoubleClick"
                  AutomationProperties.Name="Downloads">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
        </ListView>

        <!-- empty state -->
        <Grid x:Name="EmptyState" Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
            <StackPanel HorizontalAlignment="Center">

                <Grid x:Name="Hero" Width="190" Height="190" HorizontalAlignment="Center">
                    <Ellipse x:Name="OrbitRing" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                             StrokeThickness="1.5" StrokeDashArray="1.5 7" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="OrbitRotation" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Margin="26" Opacity="0.22">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Border Width="98" Height="98" CornerRadius="30" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="0" />
                                <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.35"
                                              Color="{DynamicResource SystemAccentColorPrimary}" />
                        </Border.Effect>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="46" Filled="True" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="30,38,0,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.85" />
                    <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,52,22,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.55" />
                    <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,40,30" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.7" />
                </Grid>

                <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{Binding EmptyHint}" FontSize="14" TextAlignment="Center" LineHeight="21"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:Button Appearance="Primary" Height="40" Padding="22,0" HorizontalAlignment="Center"
                           Margin="0,22,0,0" Icon="{ui:SymbolIcon Add24}" Content="Add download"
                           Command="{Binding DataContext.AddDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel x:Name="Chips" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,7,0"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Up to 32 connections" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Margin="0,0,7,0"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Pause &amp; resume anytime" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="15" Margin="0,0,7,0"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Speed limiter" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutHint" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="Shortcut" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4"
                            Padding="6,1" BorderThickness="1" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <TextBlock Text="Ctrl + N" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>

        <!-- details drawer: slides in from the right; the host keeps the page's data context, the drawer gets the details -->
        <Border x:Name="DrawerHost" Grid.Column="1" Width="400" ClipToBounds="True"
                Visibility="{Binding IsDetailsOpen, Converter={StaticResource B2V}}">
            <views:DetailsDrawer x:Name="Drawer" Width="400" HorizontalAlignment="Left"
                                 DataContext="{Binding Details}" CloseRequested="OnCloseDetails" />
        </Border>
    </Grid>
</UserControl>
