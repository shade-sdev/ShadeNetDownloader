<UserControl x:Class="ShadeNetDownloader.Controls.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The open picker of a ColorPickerButton: ready-made colours, hue / saturation / brightness (and opacity) and the colour as text. -->
    <Border Margin="12" Width="268" Padding="14" CornerRadius="10" BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <WrapPanel x:Name="Swatches" Margin="-3,-3,-3,8" />

            <TextBlock Text="Hue" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,2,0,6">
                <Border Height="6" CornerRadius="3" Margin="8,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.167" />
                            <GradientStop Color="#00FF00" Offset="0.333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.667" />
                            <GradientStop Color="#FF00FF" Offset="0.833" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Slider x:Name="HueSlider" Minimum="0" Maximum="359" ValueChanged="OnSlider"
                        AutomationProperties.Name="Hue" />
            </Grid>

            <TextBlock Text="Saturation" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="SaturationSlider" Minimum="0" Maximum="1" Margin="0,2,0,6" ValueChanged="OnSlider"
                    AutomationProperties.Name="Saturation" />

            <TextBlock Text="Brightness" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Margin="0,2,0,6" ValueChanged="OnSlider"
                    AutomationProperties.Name="Brightness" />

            <StackPanel x:Name="OpacityPanel">
                <TextBlock Text="Opacity" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="255" Margin="0,2,0,6" ValueChanged="OnSlider"
                        AutomationProperties.Name="Opacity" />
            </StackPanel>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Preview" Width="30" Height="30" CornerRadius="6" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <ui:TextBox x:Name="HexBox" Grid.Column="1" PlaceholderText="#RRGGBB" ClearButtonEnabled="False"
                            FontFamily="Consolas" KeyDown="OnHexKey" LostKeyboardFocus="OnHexCommit"
                            AutomationProperties.Name="Colour as text" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
