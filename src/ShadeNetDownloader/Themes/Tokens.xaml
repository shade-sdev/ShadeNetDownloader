<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Design tokens: spacing (4-pt grid), radii and type sizes. Colours always come from WPF-UI's theme brushes so
         light / dark / accent switching never needs a second code path. -->

    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <!-- small status badges and count badges: a rounded rectangle, not an oval -->
    <CornerRadius x:Key="RadiusBadge">5</CornerRadius>

    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>

    <Thickness x:Key="PagePadding">32,24,32,16</Thickness>

    <!-- (the sidebar's width, and the drop hint's margin that follows it, come from MainViewModel: it can show icons only) -->

    <!-- Motion: 150-250 ms ease-out -->
    <Duration x:Key="MotionFast">0:0:0.15</Duration>
    <Duration x:Key="MotionBase">0:0:0.22</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

</ResourceDictionary>
