{
  "manifest_version": 3,
  "name": "ShadeNet Downloader Integration",
  "description": "Sends downloads from your browser to ShadeNet Downloader, with the cookies and referrer the site needs.",
  "version": "1.2.0",
  "minimum_chrome_version": "109",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "ShadeNet Downloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["downloads", "cookies", "webRequest", "contextMenus", "nativeMessaging", "storage", "declarativeNetRequestWithHostAccess", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
