<Project Sdk="Microsoft.NET.Sdk">

    <!-- A stand-in for the running ShadeNet in the installer's tests. It is built as "ShadeNetDownloader.exe" because the installer
         looks for a running program by that name inside the folder it is about to change. Not part of the product. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>ShadeNetDownloader</AssemblyName>
        <RootNamespace>ShadeNet.StandIn</RootNamespace>
        <UseAppHost>true</UseAppHost>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

</Project>
