        <ProjectReference Include="..\..\tools\ShadeNet.Cli\ShadeNet.Cli.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
